INFLUX_USER=admin
INFLUX_PASSWORD=
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
REDIS_PASSWORD=replace-with-a-local-password
RABBITMQ_DEFAULT_PASS=replace-with-a-local-password
SEATA_IP=172.25.0.4
# Copy this file to the repository-root .env and fill secrets locally.
# Java config and discovery endpoint for this environment's Nacos.
NACOS_ADDRESS=127.0.0.1:18848
AGNO_POSTGRES_VOLUME=bolee-public-agno-pgdata
AGNO_MODEL_API_KEY=
# Python runs in Docker and calls the host's OAuth service through this alias.
AGNO_OAUTH_TOKEN_URL=http://host.docker.internal:7078/oauth/service-token
# Java runs on the host, so its OAuth and Agent endpoints use host loopback.
AGNO_OAUTH_CHAT_TOKEN_URL=http://127.0.0.1:7078/oauth/service-token
AGNO_OAUTH_CLIENT_ID=bolee-agno-tools
AGNO_OAUTH_CLIENT_SECRET=
AGNO_OAUTH_SCOPE=product.catalog.read policy.own.read
AGNO_OAUTH_TOKEN_KEY_URL=http://host.docker.internal:7078/oauth/token_key
AGNO_JAVA_OAUTH_TOKEN_KEY_URL=http://127.0.0.1:7078/oauth/token_key
AGNO_OAUTH_CHAT_TOKEN_KEY_URL=http://127.0.0.1:7078/oauth/token_key
AGNO_CHAT_OAUTH_CLIENT_ID=bolee-java-agent-chat
AGNO_CHAT_OAUTH_CLIENT_SECRET=
AGNO_CHAT_OAUTH_SCOPE=agent.chat
AGNO_OPERATOR_OAUTH_CLIENT_ID=
AGNO_OPERATOR_OAUTH_SCOPE=agent.operator
AGNO_OPERATOR_CLEANUP_OAUTH_CLIENT_ID=
AGNO_OPERATOR_CLEANUP_OAUTH_CLIENT_SECRET=
AGNO_OPERATOR_CLEANUP_OAUTH_SCOPE=agent.operator
AGNO_TAG_GENERATION_CLIENT_ID=bolee-agno-tag-generator
AGNO_TAG_GENERATION_CLIENT_SECRET=
AGNO_TAG_GENERATION_SCOPE=product.tags.generate
BOLEE_OAUTH_KEY_STORE=file:/replace/with/local/secrets/oauth-signing.jks
BOLEE_OAUTH_KEY_STORE_PASSWORD=
BOLEE_OAUTH_KEY_ALIAS=bolee-oauth
BOLEE_OAUTH_KEY_PASSWORD=
