# Copy this file to the repository-root .env and fill secrets locally.
# Java config and discovery endpoint for this environment's Nacos.
NACOS_ADDRESS=127.0.0.1:18848
AGNO_POSTGRES_VOLUME=bolee-cloud_agno_pgdata
AGNO_MODEL_API_KEY=
# Python runs in Docker and calls the host's OAuth service through this alias.
AGNO_OAUTH_TOKEN_URL=http://host.docker.internal:7078/oauth/service-token
# Java runs on the host, so its OAuth and Agent endpoints use host loopback.
AGNO_OAUTH_CHAT_TOKEN_URL=http://127.0.0.1:7078/oauth/service-token
AGNO_OAUTH_CLIENT_ID=bolee-agno-tools
AGNO_OAUTH_CLIENT_SECRET=
AGNO_OAUTH_SCOPE=product.catalog.read policy.own.read product.terms.read
AGNO_TERMS_INDEXER_CLIENT_ID=bolee-agno-terms-indexer
AGNO_OAUTH_TOKEN_KEY_URL=http://host.docker.internal:7078/oauth/token_key
AGNO_JAVA_OAUTH_TOKEN_KEY_URL=http://127.0.0.1:7078/oauth/token_key
AGNO_OAUTH_CHAT_TOKEN_KEY_URL=http://127.0.0.1:7078/oauth/token_key
AGNO_CHAT_OAUTH_CLIENT_ID=bolee-java-agent-chat
AGNO_CHAT_OAUTH_CLIENT_SECRET=
AGNO_CHAT_OAUTH_SCOPE=agent.chat
AGNO_OPERATOR_OAUTH_CLIENT_ID=
AGNO_OPERATOR_OAUTH_SCOPE=agent.operator
AGNO_AGENTOS_ADMIN_SOURCE_CLIENT_ID=insurance-mgt
AGNO_AGENTOS_ADMIN_ISSUER=bolee-security-oauth
AGNO_AGENTOS_ADMIN_AUDIENCE=bolee-insurance-agent-os
AGNO_AGENTOS_AUDITOR_ROLE_LABEL=agent_conversation_auditor
AGNO_AGENTOS_ADMIN_CORS_ORIGINS=http://127.0.0.1:18166,http://localhost:18166
AGNO_OPERATOR_CLEANUP_OAUTH_CLIENT_ID=
AGNO_OPERATOR_CLEANUP_OAUTH_CLIENT_SECRET=
AGNO_OPERATOR_CLEANUP_OAUTH_SCOPE=agent.operator
AGNO_TAG_GENERATION_CLIENT_ID=bolee-agno-tag-generator
AGNO_TAG_GENERATION_CLIENT_SECRET=
AGNO_TAG_GENERATION_SCOPE=product.tags.generate
BOLEE_OAUTH_KEY_STORE=file:/replace/with/local/secrets/oauth-signing.jks
BOLEE_OAUTH_KEY_STORE_PASSWORD=
BOLEE_OAUTH_KEY_ALIAS=bolee-oauth
BOLEE_OAUTH_KEY_PASSWORD=
BOLEE_OAUTH_DB_URL=
BOLEE_OAUTH_DB_USERNAME=
BOLEE_OAUTH_DB_PASSWORD=
BOLEE_OAUTH_REDIS_PASSWORD=
BOLEE_INSURANCE_DB_URL=
BOLEE_INSURANCE_DB_USERNAME=
BOLEE_INSURANCE_DB_PASSWORD=
BOLEE_INSURANCE_REDIS_PASSWORD=
SPRING_TASK_EXTCUTOR_CORE_POOL_SIZE=5
SPRING_TASK_EXTCUTOR_MAX_POOL_SIZE=5
SPRING_TASK_EXTCUTOR_QUEUE_CAPACITY=4096
AGNO_MODEL_ID=deepseek-chat
AGNO_MODEL_BASE_URL=https://api.deepseek.com/v1
AGNO_CONTEXT_WINDOW_TOKENS=32768
AGNO_CONTEXT_FIXED_TOKENS=6000
AGNO_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
AGNO_CONTEXT_SAFETY_MARGIN_TOKENS=2048
AGNO_CONTEXT_TOOL_RESULT_RESERVE_TOKENS=8192
AGNO_CONTEXT_SOFT_LIMIT_RATIO=0.75
AGNO_CONTEXT_RECENT_TURNS=6
AGNO_CONTEXT_KEEP_RECENT_TURNS=2
AGNO_CONTEXT_SUMMARY_MAX_CHARS=4000
AGNO_CONTEXT_SESSION_LOCK_TIMEOUT_SECONDS=30
# Optional; defaults to AGNO_MODEL_ID
AGNO_CONTEXT_SUMMARY_MODEL_ID=
AGNO_TOOL_RESULT_MAX_TOKENS=1200
AGNO_JAVA_SERVICE_URL=http://host.docker.internal:17065
AGNO_JAVA_HTTP_TIMEOUT_SECONDS=10
AGNO_TERMS_INDEXER_CLIENT_SECRET=
AGNO_TERMS_INDEXER_SCOPE=product.terms.index
AGNO_TERMS_INDEXER_JAVA_URL=http://host.docker.internal:17065
# Use a URL-encoded password; provision a dedicated PostgreSQL role with access only to insurance_terms.
AGNO_TERMS_DATABASE_URL=postgresql://ai:change-this-local-password@agentos-db:5432/agentos
AGNO_TERMS_INDEX_DATABASE_URL=postgresql://ai:change-this-local-password@agentos-db:5432/agentos
AGNO_TERMS_EMBEDDING_BASE_URL=http://terms-embedding:11434/v1
AGNO_TERMS_EMBEDDING_API_KEY=ollama
AGNO_TERMS_EMBEDDING_MODEL=bge-m3
AGNO_TERMS_EMBEDDING_DIMENSIONS=1024
AGNO_TERMS_EMBEDDING_TIMEOUT_SECONDS=120
AGNO_TERMS_WORKER_POLL_SECONDS=2
AGNO_TERMS_MAX_FILE_BYTES=52428800
AGNO_ENABLED=false
AGNO_SERVICE_URL=http://127.0.0.1:8000
AGNO_CONNECT_TIMEOUT_MS=3000
AGNO_READ_TIMEOUT_MS=120000
AGNO_DB_USER=ai
AGNO_DB_PASSWORD=change-this-local-password
AGNO_DB_NAME=agentos
# Set these in the environment used to start insurance-mgt after provisioning
# a bucket-scoped MinIO user for insurance documents and product media. Keep real credentials only in local secrets.
INSURANCE_TERMS_STORAGE_ENABLED=false
INSURANCE_TERMS_MINIO_ENDPOINT=http://127.0.0.1:19000
INSURANCE_TERMS_MINIO_ENABLED=true
INSURANCE_TERMS_MINIO_ACCESS_KEY=
INSURANCE_TERMS_MINIO_SECRET_KEY=
INSURANCE_TERMS_MINIO_BUCKET=insurance-source-files
INSURANCE_TERMS_MAX_FILE_SIZE_BYTES=52428800
ALIPAY_ENVIRONMENT=SANDBOX
ALIPAY_SANDBOX_GATEWAY_HOST=openapi-sandbox.dl.alipaydev.com
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_MERCHANT_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_SANDBOX_NOTIFY_URL=
BOLEE_PAYMENT_RETURN_URL=http://127.0.0.1:18177/payment-result.html
AI_PERSISTENCE_ENABLED=false
AI_IDEMPOTENCY_ENCRYPTION_KEY=
AI_DELETION_LEDGER_PATH=
AI_DELETION_LEDGER_REPLAY_ON_STARTUP=false
AI_RETENTION_CONVERSATION_DAYS=
AI_RETENTION_TRACE_DAYS=
AI_RETENTION_CLEANUP_TASK_DAYS=
