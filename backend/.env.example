AGNO_MODEL_BASE_URL=https://api.deepseek.com/v1
AGNO_CONTEXT_WINDOW_TOKENS=32768
AGNO_CONTEXT_FIXED_TOKENS=6000
AGNO_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
AGNO_CONTEXT_SAFETY_MARGIN_TOKENS=2048
AGNO_CONTEXT_TOOL_RESULT_RESERVE_TOKENS=8192
AGNO_CONTEXT_SOFT_LIMIT_RATIO=0.75
